PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development
TAX_RATE=0.16

# Secreto para firma HMAC-SHA256 de tokens de sesión y cookies HttpOnly
AUTH_SECRET=cambia_este_secreto_en_produccion

# Cadena de conexión PostgreSQL de Supabase (Shared Pooler en puerto 6543 con SSL)
# En Supabase Dashboard -> Connect -> Transaction/Session Pooler (Port 6543)
DATABASE_URL=postgresql://postgres.[TU_PROJECT_REF]:[TU_PASSWORD_DB]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Credenciales de Mercado Pago (Dashboard de Desarrolladores -> Credenciales de Prueba / Producción)
# IMPORTANTE: MP_ACCESS_TOKEN es secreto y solo debe usarse en el backend / Vercel Environment Variables
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# Configuración de cuenta administrativa exclusiva (solo hash scrypt, nunca contraseña en texto plano)
ADMIN_EMAIL=Admin1Sup@exodoadmin1.com
ADMIN_PASSWORD_HASH=e8a4f2c91b7d3056a9c2e4f180b3d7a5:cca5076d361c7b272ec55d2215601cf36f84a64fbcc12f332b52ef488f3cad10e3074cda2bb4702aa76ec91c16a376602fd681fe1c22e296c746e285b09d1d79

# Google OAuth 2.0 (Solo clientes; aislado del rol Administrador)
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com
