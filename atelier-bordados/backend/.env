PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development
TAX_RATE=0.16

# Secreto para firma HMAC-SHA256 de tokens y cookies HttpOnly
AUTH_SECRET=exodo_atelier_hilo_jwt_hmac_secret_2026_secure

# Conexión PostgreSQL de Supabase (Reemplazar con tu URI real de Supabase -> Settings -> Database -> Connection string URI)
# Ejemplo: postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Cuenta exclusiva de Administrador (verificada en backend; NUNCA expuesta al frontend ni vinculada a Google OAuth)
ADMIN_EMAIL=Admin1Sup@exodoadmin1.com
ADMIN_PASSWORD_HASH=e8a4f2c91b7d3056a9c2e4f180b3d7a5:cca5076d361c7b272ec55d2215601cf36f84a64fbcc12f332b52ef488f3cad10e3074cda2bb4702aa76ec91c16a376602fd681fe1c22e296c746e285b09d1d79

# Google OAuth 2.0 (Exclusivo para clientes; bloqueado para cuentas con rol Administrador)
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Mercado Pago (Credenciales de Prueba Sandbox o Producción — MP_ACCESS_TOKEN solo en backend)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
